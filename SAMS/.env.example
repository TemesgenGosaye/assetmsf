# Frontend Environment Variables (Vite)
# Copy this file to .env.local and fill in your actual values

# Supabase Configuration (optional — app works in localStorage fallback mode)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Django API Base URL (defaults to /api for local proxy)
VITE_API_BASE_URL=/api

# Supabase Proxy Settings (for CORS bypass)
VITE_USE_SUPABASE_PROXY=true
VITE_USE_SUPABASE_REWRITE=false

# Email Configuration
VITE_EMAIL_ENABLED=true
VITE_EMAIL_API_URL=/api/send-email

# Dashboard URL (for email links and external references)
VITE_DASHBOARD_URL=https://samsproject.in
